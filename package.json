{
  "name": "island-of-settlers",
  "version": "0.1.0",
  "private": true,
  "license": "CC-BY-NC-4.0",
  "description": "Island of Settlers: a seeded settlement island game rendered with Three.js",
  "type": "module",
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx tools/analysis/production-entry-audit.ts",
    "audit:production": "tsx tools/analysis/production-entry-audit.ts",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "test:slow": "vitest run --project slow",
    "test:all": "vitest run",
    "test:ui": "playwright test --project=\"smoke-*\"",
    "test:visual": "playwright test --project=\"visual-*\"",
    "test:offline": "playwright test --project=offline-catch-up",
    "offline:browser": "tsx tools/acceptance/offline-browser-worker.ts",
    "typecheck": "tsc --noEmit",
    "shots": "tsx tools/bench/screenshots.ts",
    "felling-shots": "tsx tools/bench/felling-shots.ts",
    "production-resource-previews": "tsx tools/assets/production-resource-previews.ts",
    "road-previews": "tsx tools/assets/road-previews.ts",
    "climber-foliage-atlas": "tsx tools/assets/climber-foliage-atlas.ts",
    "verge-foliage-atlas": "tsx tools/assets/verge-foliage-atlas.ts",
    "micro-detail-atlas": "tsx tools/assets/micro-detail-atlas.ts",
    "editor-icons": "tsx tools/assets/editor-icons.ts",
    "load-profile": "tsx tools/bench/load-profile.ts",
    "building-assets": "npm run building-construction && npm run building-geometry && tsx tools/bench/building-shots.ts && tsx tools/bench/nation-building-assets.ts && tsx tools/bench/neutral-building-assets.ts && npm run camp-assets && tsx tools/analysis/building-icon-coverage.ts && vitest run --project unit tests/national-building-icon-coverage.test.ts",
    "credits": "tsx tools/assets/credits.ts",
    "ktx2:audit": "tsx tools/assets/ktx2-audit.ts --check",
    "ktx2:prune": "tsx tools/assets/ktx2-audit.ts --prune",
    "building-construction": "tsx tools/catalog/building-construction.ts",
    "building-geometry": "tsx tools/catalog/building-geometry.ts",
    "project:audit": "tsx tools/analysis/project-audit.ts",
    "ui-menu-icons": "tsx tools/assets/main-selection-icons.ts",
    "commander-portraits": "tsx tools/bench/commander-portraits.ts",
    "troop-portraits": "tsx tools/bench/troop-portraits.ts",
    "camp-assets": "tsx tools/bench/themed-neutral-building-review.ts --assets && tsx tools/bench/themed-neutral-building-review.ts --assets --buildings",
    "test:e2e:full": "tsx tools/e2e/full/run.ts",
    "i18n:extract": "lingui extract",
    "i18n:apply-translations": "tsx tools/i18n/apply-translation-map.ts",
    "i18n:drafts": "tsx tools/analysis/apply-localization-drafts.ts",
    "i18n:compile": "lingui compile",
    "i18n:check": "vitest run tests/lingui-macros.test.ts tests/language-preference.test.ts tests/translation-frozen-surfaces.test.ts && tsx tools/analysis/lingui-macro-check.ts",
    "prebuild": "npm run i18n:compile",
    "lint": "oxlint --type-aware src tests tests-ui tools",
    "lint:fix": "oxlint --type-aware --fix src tests tests-ui tools",
    "knip": "knip",
    "verifier-bundle": "tsx tools/server/build-verifier.ts",
    "ai:check": "tsx tools/ai/ai-program-check.ts",
    "ai:suggest": "tsx tools/ai/ai-program-suggest.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@lingui/core": "^6.10.0",
    "@lingui/react": "^6.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@lingui/cli": "^6.10.0",
    "@lingui/vite-plugin": "^6.10.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sort-destructure-keys": "3.0.0",
    "knip": "6.42.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
